{
  "name": "bot-d",
  "relay": "slack-acp",
  "host": "host-d",
  "platform": "linux/arm64",
  "unit": "slack-acp-d",
  "require": {
    "slack_acp": ">=0.11.0 <0.12.0"
  },
  "service": {
    "config_path": "~/.config/slack-acp/bot-d/config.json",
    "state_dir": "~/.config/slack-acp/bot-d/state"
  },
  "credentials": {
    "env_file": "~/.config/slack-acp/bot-d/env"
  },
  "systemd": {
    "env_path": "%h/.local/bin:/usr/bin:/bin",
    "restart_sec": "5s",
    "timeout_stop_sec": "30s"
  },
  "config": {
    "agent_cmd": null,
    "state_dir": "/home/user-d/.config/slack-acp/bot-d/state"
  }
}
